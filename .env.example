# Copy this file to .env.local and fill in what you want. .env.local is gitignored; never commit real keys.
# Everything here is OPTIONAL: without any of it, the app still designs, simulates, deploys, trades, migrates and claims.

# --- AI Copilot (free-form questions in the Copilot / LaunchLens panels) -------------------------------------
# Without a key the rule-based Copilot still works and the ask box explains how to enable AI answers.
# Create a key at https://console.anthropic.com/ and restart `npm run dev` after adding it.
ANTHROPIC_API_KEY=
# Default model is claude-opus-5-5. Set this to use a different one (e.g. a cheaper model).
# COPILOT_MODEL=claude-opus-5-5

# --- Logo / metadata upload (Irys, devnet) --------------------------------------------------------------------
# By default the server uses the gitignored keypair file .keys/uploader.json (create it with
# `npx tsx spike/new-key.ts uploader`, then send it ~0.03 devnet SOL). To use an env var instead, put the
# 64-byte secret key as a JSON array here. This wallet pays for uploads (about 0.00004 SOL each), so keep it small.
# IRYS_UPLOADER_KEY=[...]

# --- Solana RPC -----------------------------------------------------------------------------------------------
# The public devnet RPC rate-limits; a free provider endpoint is steadier. It MUST be devnet: the app refuses
# anything else before sending a transaction.
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
